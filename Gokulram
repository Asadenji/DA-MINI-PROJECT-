# Import required libraries
import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Load Dataset
# Make sure your CSV file name is correct
data = pd.read_csv("hari.csv")

# Step 2: Convert Date column to datetime format
data['Date'] = pd.to_datetime(data['Date'])

# Step 3: Set Date as index
data.set_index('Date', inplace=True)

# Step 4: Display first few rows
print("Dataset Preview:")
print(data.head())

# Step 5: Calculate Moving Averages
data['MA5'] = data['Close'].rolling(window=5).mean()
data['MA20'] = data['Close'].rolling(window=20).mean()

# Step 6: Plot Closing Price
plt.figure()
plt.plot(data['Close'])
plt.title("Stock Closing Price")
plt.xlabel("Date")
plt.ylabel("Price")
plt.show()

# Step 7: Plot Moving Averages
plt.figure()
plt.plot(data['Close'], label='Close Price')
plt.plot(data['MA5'], label='5-Day MA')
plt.plot(data['MA20'], label='20-Day MA')
plt.legend()
plt.title("Moving Average Trend")
plt.xlabel("Date")
plt.ylabel("Price")
plt.show()

# Step 8: Autocorrelation Plot
plt.figure()
pd.plotting.autocorrelation_plot(data['Close'])
plt.title("Autocorrelation of Stock Price")
plt.show()
